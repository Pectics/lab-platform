/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# alternative lockfiles
package-lock.json
yarn.lock

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
/.data
